{
  "name": "stream-chat-agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/api/validation.test.ts src/lib/api/chat-route.test.ts src/lib/sse/openai-stream.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
